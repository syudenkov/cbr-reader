@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()

Container(webApp, "Web Application", "React SPA", "Frontend UI")
ContainerDb(database, "Database", "SQLite", "Persistent data")
Container(fileStorage, "File Storage", "Filesystem", "Blobs")
System_Ext(openai, "OpenAI API", "OCR primary")
System_Ext(claude, "Claude API", "OCR fallback")
System_Ext(minimax, "Minimax API", "TTS")

Container_Boundary(apiBackend, "API Backend Container") {
    Component(authController, "AuthController", "Spring MVC Controller", "Handles /api/auth/* endpoints: login, logout, register, session validation")
    Component(fileController, "FileController", "Spring MVC Controller", "Handles /api/files/*: upload, metadata, page serving, cover images")
    Component(ttsController, "TtsController", "Spring MVC Controller", "Handles /api/tts/*: job creation, status, results, audio streaming")
    Component(adminController, "AdminController", "Spring MVC Controller", "Handles /api/admin/*: user mgmt, logs, LLM config, feature flags")
    Component(progressController, "ProgressController", "Spring MVC Controller", "Handles /api/progress/*: reading position get/update")
    Component(ratingController, "RatingController", "Spring MVC Controller", "Handles /api/ratings/*: submit rating, get average")

    Component(authService, "AuthService", "Spring Service", "Session management, password verification, user registration")
    Component(fileService, "FileService", "Spring Service", "File upload, metadata management, cover extraction")
    Component(archiveService, "ArchiveService", "Spring Service", "ZIP/RAR extraction, page extraction, cache management")
    Component(ttsService, "TtsService", "Spring @Async Service", "Async job orchestration, progress tracking, page processing, audio concatenation")
    Component(ocrService, "OcrService", "Spring Service", "LLM fallback (OpenAI→Claude), OCR parsing, speaker extraction")
    Component(voiceService, "VoiceService", "Spring Service", "Speaker-to-voice mapping, Minimax voice inventory")
    Component(userService, "UserService", "Spring Service", "User CRUD, role management")
    Component(auditService, "AuditLogService", "Spring Service", "User action logging")
    Component(llmConfigService, "LlmConfigService", "Spring Service", "API key encryption/decryption, provider config")
    Component(cacheCleanupService, "CacheCleanupService", "Spring @Scheduled Service", "Cache TTL enforcement, size limit")

    Component(userRepo, "UserRepository", "Spring Data JPA", "users table access")
    Component(fileRepo, "FileRepository", "Spring Data JPA", "comic_files table access")
    Component(progressRepo, "ReadingProgressRepository", "Spring Data JPA", "reading_progress table")
    Component(ratingRepo, "RatingRepository", "Spring Data JPA", "ratings table")
    Component(ttsJobRepo, "TtsJobRepository", "Spring Data JPA", "tts_jobs table")
    Component(ttsResultRepo, "TtsResultRepository", "Spring Data JPA", "tts_results table")
    Component(llmConfigRepo, "LlmConfigRepository", "Spring Data JPA", "llm_config table")
    Component(auditRepo, "AuditLogRepository", "Spring Data JPA", "audit_logs table")
    Component(featureFlagRepo, "FeatureFlagRepository", "Spring Data JPA", "feature_flags table")

    Component(openaiClient, "OpenAiClient", "WebClient Wrapper", "OpenAI API integration, auth, request/response mapping")
    Component(claudeClient, "ClaudeClient", "WebClient Wrapper", "Claude API integration (fallback OCR)")
    Component(minimaxClient, "MinimaxClient", "WebClient Wrapper", "Minimax API integration (TTS)")

    Component(securityConfig, "SecurityConfig", "Spring Configuration", "Session, CSRF, auth filters")
    Component(asyncConfig, "AsyncConfig", "Spring Configuration", "ThreadPoolTaskExecutor (single-threaded)")
    Component(corsConfig, "CorsConfig", "Spring Configuration", "CORS policy for frontend origin")
    Component(cacheConfig, "CacheConfig", "Spring Configuration", "Cache directory initialization, cleanup scheduler")
}

Rel(webApp, authController, "API calls", "HTTPS/JSON")
Rel(webApp, fileController, "API calls", "HTTPS/JSON")
Rel(webApp, ttsController, "API calls", "HTTPS/JSON")
Rel(webApp, adminController, "API calls", "HTTPS/JSON")
Rel(webApp, progressController, "API calls", "HTTPS/JSON")
Rel(webApp, ratingController, "API calls", "HTTPS/JSON")

Rel(authController, authService, "Uses")
Rel(fileController, fileService, "Uses")
Rel(fileController, archiveService, "Uses")
Rel(ttsController, ttsService, "Uses")
Rel(adminController, userService, "Uses")
Rel(adminController, auditService, "Uses")
Rel(adminController, llmConfigService, "Uses")
Rel(adminController, featureFlagRepo, "Uses")
Rel(progressController, fileService, "Uses")
Rel(ratingController, fileService, "Uses")

Rel(authService, userRepo, "Uses")
Rel(authService, securityConfig, "Uses")
Rel(fileService, fileRepo, "Uses")
Rel(fileService, progressRepo, "Uses")
Rel(fileService, ratingRepo, "Uses")
Rel(archiveService, fileStorage, "Reads/writes")
Rel(archiveService, cacheCleanupService, "Cache mgmt")
Rel(ttsService, ttsJobRepo, "Uses")
Rel(ttsService, ttsResultRepo, "Uses")
Rel(ttsService, ocrService, "Uses")
Rel(ttsService, voiceService, "Uses")
Rel(ttsService, fileStorage, "Writes audio")
Rel(ttsService, asyncConfig, "Uses")
Rel(ocrService, openaiClient, "Uses")
Rel(ocrService, claudeClient, "Uses (fallback)")
Rel(ocrService, llmConfigService, "Gets API keys")
Rel(voiceService, minimaxClient, "Uses")
Rel(voiceService, llmConfigService, "Gets API key")
Rel(userService, userRepo, "Uses")
Rel(auditService, auditRepo, "Uses")
Rel(llmConfigService, llmConfigRepo, "Uses")

Rel(userRepo, database, "JDBC")
Rel(fileRepo, database, "JDBC")
Rel(progressRepo, database, "JDBC")
Rel(ratingRepo, database, "JDBC")
Rel(ttsJobRepo, database, "JDBC")
Rel(ttsResultRepo, database, "JDBC")
Rel(llmConfigRepo, database, "JDBC")
Rel(auditRepo, database, "JDBC")
Rel(featureFlagRepo, database, "JDBC")

Rel(openaiClient, openai, "HTTPS")
Rel(claudeClient, claude, "HTTPS")
Rel(minimaxClient, minimax, "HTTPS")

@enduml
